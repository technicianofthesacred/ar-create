{
  "name": "ar-create",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm ci --prefix runtime && npm ci --prefix mcp/study",
    "build": "npm run build:document-study --prefix runtime && node scripts/gen-capabilities.mjs",
    "start": "node serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:package": "node scripts/check-package.mjs",
    "demo": "node scripts/demo.mjs",
    "capabilities": "node scripts/gen-capabilities.mjs",
    "status": "node scripts/gen-status.mjs"
  }
}
