# The capabilities generator's source is scripts/gen-capabilities-portable.ts (tracked); `npm run build` bundles it to
# scripts/gen-capabilities.mjs (a build product) and runs it, which rewrites docs/CAPABILITIES.md.
scripts/gen-capabilities.mjs

# Computed from the tracked files at release time (scripts/release.mjs) and written only into <home>/service/.
source-manifest.json

# Read-only projection rebuilt from maintained compositionSpec.ts.
runtime/services/media-article-spec.mjs
.test-home/

# Synthetic magazine vault fixtures, built by the tests (never committed).
.scratch/
runtime/public/assets/study-output-canvas.css
runtime/public/assets/study-output-canvas.js
runtime/services/native-output-helpers.mjs
runtime/services/native-output-owner.test.mjs
runtime/services/render-helper.mjs
